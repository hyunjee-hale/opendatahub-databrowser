{
  "name": "databrowser",
  "version": "2.6.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "run-p type-check \"build-only {@}\" --",
    "preview": "vite preview",
    "build-only": "vite build",
    "type-check": "vue-tsc --build",
    "test": "run-p build && vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint --cache --max-warnings 0 src",
    "lint:fix": "eslint --cache --max-warnings 0 --fix src",
    "prepare": "cd .. && husky"
  },
